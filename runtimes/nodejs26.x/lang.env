# Pinned inputs of /var/lang for the nodejs26.x runtime: Node, OpenSSL, and GCC.
# The build checks each download against its SHA-256. build.sh dates /var/lang from this file's
# commits, so only inputs of /var/lang belong here.

NODE_VERSION=26.13.0
# The managed runtime's Node version. SHA-256 from https://nodejs.org/dist/v26.13.0/SHASUMS256.txt.
NODE_SHA256=986ead18ef18256831bae3e57d94aef680a7b84cfd4044f3e8471f833fbd7191

OPENSSL_VERSION=3.5.8
# SHA-256 from
# https://github.com/openssl/openssl/releases/download/openssl-3.5.8/openssl-3.5.8.tar.gz.sha256.
OPENSSL_SHA256=a8f84a39918ec6415ce765d9b429d313ba97b8143169c172e734b9514464f5b2
# Options added to OpenSSL's Configure: the managed runtime's hardened OpenSSL 3.x options and
# the definitions its build adds. They determine which algorithms the runtime offers.
OPENSSL_CONFIGURE_OPTS='no-buf-freelists no-cast no-comp no-dtls1 no-ec2m no-gost no-heartbeats no-hw no-idea no-md2 no-mdc2 no-psk no-rc2 no-rc5 no-sctp no-seed no-sm2 no-sm3 no-sm4 no-srp no-zlib -DSSL_FORBID_ENULL -DDEVRANDOM=\"/dev/urandom\" enable-ec_nistp_64_gcc_128'

GCC_VERSION=13.2.0
# SHA-256 of https://ftp.gnu.org/gnu/gcc/gcc-13.2.0/gcc-13.2.0.tar.xz.
GCC_SHA256=e275e76442a6067341a27f04c5c6b83d8613144004c0413528863dc6b5c743da

# The managed runtime's configure options: full ICU data and the Temporal global.
NODE_CONFIGURE_OPTS="--with-intl=full-icu --v8-enable-temporal-support"
